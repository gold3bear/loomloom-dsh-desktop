{
  "compilerOptions": {
    "target": "ES2024", "lib": ["ES2024", "DOM"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": "src", "outDir": "lib", "declaration": true, "strict": true,
    "exactOptionalPropertyTypes": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "verbatimModuleSyntax": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["src/**/*.ts"], "exclude": ["src/client/**"]
}
